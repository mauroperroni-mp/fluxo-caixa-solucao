        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Container\n    title Diagrama de Contêineres - Sistema de Fluxo de Caixa\n\n    Person(merchant, \&quot;Comerciante\&quot;, \&quot;Usuário final\&quot;)\n\n    System_Boundary(c1, \&quot;Sistema de Fluxo de Caixa\&quot;) {\n        Container(app_tx, \&quot;Transaction Service\&quot;, \&quot;Java / Spring Boot\&quot;, \&quot;API REST para registrar e persistir lançamentos de débito e crédito.\&quot;)\n        Container(app_cons, \&quot;Consolidation Service\&quot;, \&quot;Java / Spring Boot\&quot;, \&quot;Consumidor assíncrono que processa transações e disponibiliza API do saldo diário.\&quot;)\n        ContainerDb(db_tx, \&quot;Database Lançamentos\&quot;, \&quot;PostgreSQL\&quot;, \&quot;Armazena o histórico completo das transações efetuadas (Ledger).\&quot;)\n        ContainerDb(db_cons, \&quot;Database Consolidado / Cache\&quot;, \&quot;PostgreSQL / Redis\&quot;, \&quot;Armazena o saldo consolidado por dia e comerciante para rápida leitura.\&quot;)\n        ContainerQueue(broker, \&quot;Message Broker\&quot;, \&quot;RabbitMQ\&quot;, \&quot;Fila de mensagens para desacoplar a gravação do processamento do consolidado.\&quot;)\n    }\n\n    Rel(merchant, app_tx, \&quot;POST /api/v1/transactions\&quot;, \&quot;JSON/HTTPS\&quot;)\n    Rel(merchant, app_cons, \&quot;GET /api/v1/consolidation/daily\&quot;, \&quot;JSON/HTTPS\&quot;)\n\n    Rel(app_tx, db_tx, \&quot;Lê e escreve lançamentos\&quot;, \&quot;JDBC\&quot;)\n    Rel(app_tx, broker, \&quot;Publica evento TransactionCreatedEvent\&quot;, \&quot;AMQP\&quot;)\n    \n    Rel(broker, app_cons, \&quot;Consome eventos de lançamentos\&quot;, \&quot;AMQP\&quot;)\n    Rel(app_cons, db_cons, \&quot;Lê e atualiza saldos diários\&quot;, \&quot;JDBC/Redis\&quot;)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t9-VFcjji9Ph_0Y4D1uI-1">
